# ==========================================
# GitIgnore for Qalam Library Management System
# ==========================================

# --- Environment Variables, Credentials & Secrets ---
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
secrets/

# --- Database local files and dumps ---
*.sqlite
*.sqlite3
*.db
*.log

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Node / Frontend ---
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local

# --- Operating System & IDE ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/*
